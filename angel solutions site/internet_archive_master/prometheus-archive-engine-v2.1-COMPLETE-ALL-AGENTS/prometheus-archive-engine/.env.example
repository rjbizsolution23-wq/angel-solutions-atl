# Prometheus Archive Engine - Environment Configuration

# =============================================================================
# Internet Archive Credentials
# Get your keys at: https://archive.org/account/s3.php
# =============================================================================
IA_ACCESS_KEY=your_ia_access_key_here
IA_SECRET_KEY=your_ia_secret_key_here

# =============================================================================
# AI Model API Keys
# =============================================================================

# Anthropic (Claude) - REQUIRED
# Get key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (GPT-4o) - Optional
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL 18.3
DATABASE_URL=postgresql://postgres:password@localhost:5432/prometheus_archive
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# =============================================================================
# Stripe Payment Integration
# Get keys at: https://dashboard.stripe.com/apikeys
# =============================================================================
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
# Application Settings
# =============================================================================
SECRET_KEY=generate-a-secure-random-key-here
ENVIRONMENT=development  # development | staging | production
DEBUG=True

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# File Storage
UPLOAD_DIR=/tmp/prometheus-uploads
MAX_FILE_SIZE_MB=500

# =============================================================================
# Monitoring & Logging
# =============================================================================

# Sentry (Optional)
# SENTRY_DSN=https://your-sentry-dsn-here

# Log Level
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL

# =============================================================================
# Celery (Background Tasks)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SOFT_TIME_LIMIT=3600  # 1 hour
CELERY_TASK_TIME_LIMIT=7200  # 2 hours

# =============================================================================
# Email Configuration (Optional - for notifications)
# =============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@prometheus-archive.com

# =============================================================================
# Application URLs
# =============================================================================
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
WEBHOOK_BASE_URL=https://your-domain.com  # For Stripe webhooks

# =============================================================================
# Security
# =============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ENABLED=True

# JWT Settings
JWT_SECRET_KEY=generate-another-secure-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# Business Configuration
# =============================================================================
COMPANY_NAME=Your Company Name
SUPPORT_EMAIL=support@your-company.com
BRAND_NAME=Your Brand

# Default pricing (in USD cents)
DEFAULT_BOOK_PRICE=999  # $9.99
DEFAULT_BUNDLE_PRICE=3999  # $39.99
DEFAULT_COURSE_PRICE=9999  # $99.99

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_BOOK_REBRANDING=True
ENABLE_GAME_COLLECTIONS=True
ENABLE_COURSE_GENERATION=True
ENABLE_MONETIZATION=True
ENABLE_ANALYTICS=True

# =============================================================================
# AI Model Configuration
# =============================================================================
DEFAULT_AI_MODEL=claude  # claude | gpt4
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4000
AI_CHUNK_SIZE=8000  # Characters per chunk for book processing

# =============================================================================
# Internet Archive Search Defaults
# =============================================================================
IA_DEFAULT_MAX_RESULTS=100
IA_SEARCH_TIMEOUT=30  # seconds
IA_DOWNLOAD_TIMEOUT=300  # seconds

# =============================================================================
# Development Tools
# =============================================================================
# Enable FastAPI auto-reload
RELOAD=True

# Enable detailed error messages
SHOW_DETAILED_ERRORS=True
