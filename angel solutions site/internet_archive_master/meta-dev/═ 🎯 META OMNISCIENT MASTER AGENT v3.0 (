Copyfrom facebook_business.api import FacebookAdsApi
from facebook_business.adobjects.adaccount import AdAccount
from facebook_business.adobjects.campaign import Campaign
from facebook_business.adobjects.adset import AdSet
from facebook_business.adobjects.ad import Ad
from facebook_business.adobjects.targeting import Targeting
import os

class MetaAdsManager:
    def __init__(self):
        self.api = FacebookAdsApi.init(
            app_id=os.getenv('FB_APP_ID'),
            app_secret=os.getenv('FB_APP_SECRET'),
            access_token=os.getenv('FB_ACCESS_TOKEN')
        )
        self.account = AdAccount(f"act_{os.getenv('AD_ACCOUNT_ID')}")
    
    def create_full_campaign(self, name, budget, targeting_params):
        """Create campaign → ad set → ad in one flow"""
        
        # 1. Create Campaign
        campaign = self.account.create_campaign(
            params={
                'name': f'{name} - Campaign',
                'objective': 'OUTCOME_SALES',
                'status': 'PAUSED',
                'special_ad_categories': []
            }
        )
        print(f"✅ Campaign created: {campaign['id']}")
        
        # 2. Create Ad Set
        ad_set = self.account.create_ad_set(
            params={
                'name': f'{name} - Ad Set',
                'campaign_id': campaign['id'],
                'billing_event': 'IMPRESSIONS',
                'optimization_goal': 'OFFSITE_CONVERSIONS',
                'bid_amount': 500,  # cents
                'daily_budget': budget * 100,  # dollars to cents
                'targeting': targeting_params,
                'status': 'PAUSED'
            }
        )
        print(f"✅ Ad Set created: {ad_set['id']}")
        
        # 3. Create Ad
        ad = self.account.create_ad(
            params={
                'name': f'{name} - Ad',
                'adset_id': ad_set['id'],
                'creative': {
                    'object_story_spec': {
                        'page_id': os.getenv('PAGE_ID'),
                        'link_data': {
                            'message': 'Check this out!',
                            'link': 'https://example.com',
                            'image_hash': '<IMAGE_HASH>',
                            'call_to_action': {
                                'type': 'SHOP_NOW'
                            }
                        }
                    }
                },
                'status': 'PAUSED'
            }
        )
        print(f"✅ Ad created: {ad['id']}")
        
        return {
            'campaign_id': campaign['id'],
            'ad_set_id': ad_set['id'],
            'ad_id': ad['id']
        }
    
    def get_campaign_insights(self, campaign_id, date_range):
        """Fetch performance metrics"""
        campaign = Campaign(campaign_id)
        insights = campaign.get_insights(
            fields=[
                'impressions',
                'clicks',
                'spend',
                'cpc',
                'ctr',
                'cpm',
                'reach',
                'frequency',
                'actions'
            ],
            params={
                'time_range': date_range,
                'level': 'campaign'
            }
        )
        
        return list(insights)[0] if insights else None

# Usage
manager = MetaAdsManager()

targeting = Targeting()
targeting['geo_locations'] = {'countries': ['US']}
targeting['age_min'] = 25
