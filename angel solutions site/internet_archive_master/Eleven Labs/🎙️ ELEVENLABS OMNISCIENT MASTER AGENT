import { ElevenLabsClient } from "@elevenlabs/elevenlabs-js";
import WebSocket from "ws";

class VoiceAgent {
  private sttWs: WebSocket;
  private ttsWs: WebSocket;
  private llm: LLMClient;
  
  async start() {
    // 1. Connect STT WebSocket
    this.sttWs = new WebSocket(
      "wss://api.elevenlabs.io/v1/speech-to-text-realtime" +
      "?model_id=scribe_v2_realtime&enable_vad=true"
    );
    
    // 2. Connect TTS WebSocket
    this.ttsWs = new WebSocket(
      "wss://api.elevenlabs.io/v1/text-to-speech/Rachel/stream-input" +
      "?model_id=eleven_flash_v2_5"
    );
    
    // 3. Stream audio to STT
    this.sttWs.on("message", async (data) => {
      const transcript = JSON.parse(data.toString());
      
      if (transcript.is_final) {
        // 4. Send to LLM
        const response = await this.llm.generate(transcript.text);
        
        // 5. Stream LLM response to TTS
        for (const chunk of response) {
          this.ttsWs.send(JSON.stringify({
            text: chunk,
            try_trigger_generation: true
          }));
        }
        
        // 6. Signal end
        this.ttsWs.send(JSON.stringify({ flush: true }));
      }
    });
    
    // 7. Play audio output
    this.ttsWs.on("message", (data) => {
      const audio = JSON.parse(data.toString());
      if (audio.audio) {
        this.playAudio(Buffer.from(audio.audio, "base64"));
      }
    });
  }
}
